# ==============================================================================
# P2P BitTorrent Clone - Environment Configuration Example
# Copy this file to .env and adjust variables as needed for your environment.
# ==============================================================================

# Tracker Server Configuration
TRACKER_PORT=8080
TRACKER_URL=http://localhost:8080

# Peer Node Configuration
PEER_PORT=6881
PEER_HOST=127.0.0.1
PEER_DATA_DIR=./data/peer

# Peer Web UI Dashboard Configuration
WEBUI_PORT=8081

# Swarm & Transfer Tuning
MAX_ACTIVE_DOWNLOADS=5
MAX_ACTIVE_UPLOADS=5
PIPELINE_DEPTH=3
IO_TIMEOUT_MS=4000
