# ==============================================================================
# P2P BitTorrent Clone - Environment Configuration Example
#
# Copy this file to `.env` in the directory you start the binaries from:
#     cp .env.example .env
# Both TrackerApp and PeerApp read `.env` at startup. A variable that is already
# nonempty in the real process environment is never overwritten, so exports in a
# shell or a container's `environment:` block take precedence.
#
# Command-line flags always win over the values below.
# ==============================================================================

# ---- Tracker ----------------------------------------------------------------
# Port TrackerApp listens on (flag: -p / --port).
TRACKER_PORT=8080
# URL a peer uses to reach the tracker (flag: --tracker).
TRACKER_URL=http://localhost:8080

# ---- Peer -------------------------------------------------------------------
# Upload server port; 0 asks the OS for a free port (flag: -p / --port).
PEER_PORT=6881
# Address or hostname announced to the tracker (flag: --announce-ip).
# Leave empty to detect the outbound interface automatically.
PEER_HOST=
# Working directory: SQLite state, generated metadata, shared files.
PEER_DATA_DIR=./data/peer

# ---- Web dashboard ----------------------------------------------------------
# Port for the browser dashboard; still needs the --webui flag to start it.
WEBUI_PORT=8081

# ---- Swarm and transfer tuning ----------------------------------------------
# Command-line flags override the corresponding values below.
MAX_ACTIVE_DOWNLOADS=5
# Aggregate receive cap in MiB/s, across all sources (0 = unlimited).
# For a live demo use 10, or pass --download-limit-mbps 10.
DOWNLOAD_LIMIT_MBPS=0
MAX_ACTIVE_UPLOADS=5
PIPELINE_DEPTH=3
IO_TIMEOUT_MS=4000
